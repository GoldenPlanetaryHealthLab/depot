{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depot:registry:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "source", "destination", "versions", "policy", "checks", "catalogue"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["prospector", "releases"],
      "properties": {"prospector": {"type": "string", "minLength": 1}, "releases": {"type": "string", "minLength": 1}}
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "target"],
      "properties": {"layer": {"enum": ["02_prospects", "03_refined"]}, "target": {"type": "string", "minLength": 1}}
    },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern"],
      "properties": {"pattern": {"type": "string", "minLength": 1}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"const": "automatic"},
        "approved_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["required_fields", "nonempty"],
      "properties": {
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "nonempty": {"type": "boolean"},
        "minimum_rows": {"type": "integer", "minimum": 0}
      }
    },
    "catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["visible", "audience"],
      "properties": {"visible": {"type": "boolean"}, "audience": {"type": "string", "minLength": 1}}
    }
  }
}
